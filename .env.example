# Supabase Configuration (用于后端数据库和用户认证)
# 在 https://supabase.com 注册并创建项目，在 Project Settings -> API 中获取
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI Vision & OCR Configuration (用于自动打标、OCR、生成图片语义描述)
# 智谱AI配置示例 (推荐，有永久免费的 GLM-4V-Flash)
VITE_OPENAI_API_KEY=你的智谱API_KEY
VITE_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VITE_OPENAI_MODEL=glm-4v-flash

# 阿里百炼配置示例 (可选，需注册获取，可免费送额度，单价极低)
# VITE_OPENAI_API_KEY=你的阿里API_KEY
# VITE_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VITE_OPENAI_MODEL=qwen-vl-max
